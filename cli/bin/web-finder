#!/usr/bin/env node
/**
 * web-finder - scan your Tailscale network for web interfaces
 *
 * Usage:
 *   web-finder                 # Scan local + Tailscale, human-readable
 *   web-finder start --auto-publish  # Recommended setup
 *   web-finder start                 # Passive default
 *                               # Also publish detected local web UIs
 *   web-finder stop            # Stop sharing and disable autostart
 *   web-finder status          # Check daemon, Tailscale Serve, DNS, version
 *   web-finder --json          # Machine-readable JSON output
 */

const path = require('path');
const fs   = require('fs');
const { execFileSync, execSync } = require('child_process');

// Resolve symlinks so scanner.js is found even when binary is symlinked to /usr/local/bin
const realBin  = fs.realpathSync(__filename);
const repoRoot = path.join(path.dirname(realBin), '..');
const { scanLocalSS, scanTailscale, scanGateway, getTailscaleServeRoutes, parseTailscaleServeStatus, parseTailscaleServeStatusJSON, MANIFEST_PORT, MANIFEST_PATH, GLOBAL_MANIFEST_PATH } = require(path.join(repoRoot, 'scanner.js'));
const { parseAutoPublishState, planServeReconciliation } = require(path.join(repoRoot, 'serve-state.js'));
const { applyServiceConfig, configPath, loadConfig } = require(path.join(repoRoot, 'config.js'));
const http = require('http');
const net  = require('net');
const os   = require('os');
const dns  = require('dns').promises;

const AUTO_PUBLISH_STATE = path.join(os.homedir(), '.web-finder-auto-published-ports');
const LAUNCHD_PATH = '/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin';

const pkg  = JSON.parse(fs.readFileSync(path.join(repoRoot, 'package.json'), 'utf8'));
const TAILSCALE_PATHS = [
  'tailscale',
  '/Applications/Tailscale.app/Contents/MacOS/Tailscale',
  '/usr/local/bin/tailscale',
  '/opt/homebrew/bin/tailscale',
  '/volume1/@appstore/Tailscale/bin/tailscale',
];

function quoteShell(str) {
  return `"${String(str).replace(/"/g, '\\"')}"`;
}

function tailscaleCommand() {
  for (const candidate of TAILSCALE_PATHS) {
    if (candidate === 'tailscale') {
      try {
        const resolved = execSync('command -v tailscale', { encoding: 'utf8' }).trim();
        if (resolved) return resolved;
      } catch {}
    } else if (fs.existsSync(candidate)) {
      return candidate;
    }
  }
  return null;
}

function execTailscale(args, options = {}) {
  const cmd = tailscaleCommand();
  if (!cmd) throw new Error('tailscale command not found');
  if (!Array.isArray(args)) throw new TypeError('execTailscale expects an argument array');
  return execFileSync(cmd, args, { encoding: 'utf8', stdio: ['ignore', 'pipe', 'pipe'], ...options });
}

function publisherURL() {
  try {
    const status = JSON.parse(execTailscale(['status', '--json']));
    const dnsName = String(status?.Self?.DNSName || '').replace(/\.$/, '');
    if (dnsName) return `https://${dnsName}:${MANIFEST_PORT}${GLOBAL_MANIFEST_PATH}`;
    const ip = (status?.Self?.TailscaleIPs || []).find(candidate => !candidate.includes(':'));
    if (ip) return `http://${ip}:${MANIFEST_PORT}${GLOBAL_MANIFEST_PATH}`;
  } catch {}
  return null;
}

function tailscaleBackendWarning(status) {
  const state = String(status?.BackendState || '').trim();
  if (!state || state.toLowerCase() === 'running') return null;
  if (state.toLowerCase() === 'needslogin') {
    return 'Tailscale is signed out. Open Tailscale and sign in to see devices.';
  }
  return `Tailscale is ${state}. Turn it on to see devices.`;
}

function currentTailscaleOperator() {
  try {
    const prefs = JSON.parse(execTailscale(['debug', 'prefs']));
    return prefs.OperatorUser || '';
  } catch {
    return null;
  }
}

function promptYesNo(question) {
  if (!process.stdin.isTTY || !process.stdout.isTTY) return false;
  try {
    process.stdout.write(`${question} [y/N] `);
    const buf = Buffer.alloc(128);
    const bytes = fs.readSync(0, buf, 0, buf.length, null);
    const answer = buf.toString('utf8', 0, bytes).trim().toLowerCase();
    return answer === 'y' || answer === 'yes';
  } catch {
    return false;
  }
}

function tailscaleOperatorCommandForDisplay() {
  return 'sudo tailscale set --operator=$USER';
}

function printAutoPublishPermissionInstructions() {
  console.error('Auto-publish needs local Tailscale operator permission on Linux.');
  console.error('Run once:');
  console.error(`  ${tailscaleOperatorCommandForDisplay()}`);
  console.error('');
  console.error('Then rerun:');
  console.error('  web-finder start --auto-publish');
}

function ensureLinuxAutoPublishPermission() {
  if (process.platform !== 'linux') return true;

  const user = os.userInfo().username;
  if (!user || user === 'root') return true;

  const currentOperator = currentTailscaleOperator();
  if (currentOperator === null) return true;
  if (currentOperator === user) return true;
  if (currentOperator) {
    console.error(`Tailscale operator is already set to ${currentOperator}. WebFinder will not change it.`);
    console.error('Ask that user or an admin to run WebFinder, or update the Tailscale operator manually.');
    return false;
  }

  if (!process.stdin.isTTY || !process.stdout.isTTY) {
    printAutoPublishPermissionInstructions();
    return false;
  }

  const cmd = tailscaleCommand();
  if (!cmd) {
    console.error('Auto-publish needs Tailscale, but the tailscale command was not found.');
    return false;
  }

  console.log('');
  console.log('Auto-publish needs local Tailscale operator permission on Linux so WebFinder can manage Tailscale Serve mappings for detected web UIs.');
  console.log('');
  console.log('Run this now?');
  console.log(`  ${tailscaleOperatorCommandForDisplay()}`);
  console.log('');

  if (!promptYesNo('Continue?')) {
    console.error('Auto-publish was not started. Run `web-finder start` for passive mode, or rerun `web-finder start --auto-publish` and approve the Tailscale operator setup.');
    return false;
  }

  try {
    execSync(`sudo ${quoteShell(cmd)} set --operator=${quoteShell(user)}`, { stdio: 'inherit' });
  } catch (e) {
    console.error('Failed to set Tailscale operator permission:', e.message);
    return false;
  }

  const nextOperator = currentTailscaleOperator();
  if (nextOperator && nextOperator !== user) {
    console.error(`Tailscale operator is now set to ${nextOperator}, not ${user}. Auto-publish was not started.`);
    return false;
  }

  return true;
}

function isTailscaleServePermissionError(error) {
  const msg = error?.message || '';
  return msg.includes('serve config denied') || msg.includes('tailscale set --operator');
}

function printTailscaleServePermissionHelp({ autoPublish = false } = {}) {
  console.error('Tailscale Serve setup skipped: local Tailscale operator permission is required.');
  console.error('Run once:');
  console.error(`  ${tailscaleOperatorCommandForDisplay()}`);
  console.error('');
  console.error('Then rerun:');
  console.error(`  web-finder start${autoPublish ? ' --auto-publish' : ''}`);
}

function readAutoPublishState() {
  try {
    return parseAutoPublishState(fs.readFileSync(AUTO_PUBLISH_STATE, 'utf8'));
  } catch {
    return parseAutoPublishState('');
  }
}

function readAutoPublishedPorts() {
  const state = readAutoPublishState();
  return Array.from(new Set([
    ...state.routes.map(route => route.externalPort),
    ...state.legacyPorts,
  ])).sort((a, b) => a - b);
}

function writeAutoPublishState(state) {
  if (!state.routes.length) {
    try { fs.unlinkSync(AUTO_PUBLISH_STATE); } catch {}
    return;
  }
  const tmp = `${AUTO_PUBLISH_STATE}.${process.pid}.tmp`;
  fs.writeFileSync(tmp, `${JSON.stringify(state, null, 2)}\n`, { mode: 0o600 });
  fs.renameSync(tmp, AUTO_PUBLISH_STATE);
}

function hasCommand(cmd) {
  try {
    execSync(`command -v ${cmd}`, { encoding: 'utf8' });
    return true;
  } catch {
    return false;
  }
}

function sameRealPath(a, b) {
  try {
    return fs.realpathSync(a) === fs.realpathSync(b);
  } catch {
    return false;
  }
}

function preferredBinPath() {
  const candidates = [
    process.argv[1],
    '/opt/homebrew/bin/web-finder',
    '/usr/local/bin/web-finder',
    realBin,
  ];
  return candidates.find(candidate => candidate && fs.existsSync(candidate) && sameRealPath(candidate, realBin)) || realBin;
}

function autostartNodeCommand() {
  return [process.execPath];
}

function autostartUsesAutoPublish() {
  const info = getAutostartInfo();
  const files = [info.plist, info.unit, info.init].filter(Boolean);
  for (const file of files) {
    try {
      if (fs.readFileSync(file, 'utf8').includes('--auto-publish')) return true;
    } catch {}
  }
  if (info.type === 'cron' && hasCommand('crontab')) {
    try {
      return execSync('crontab -l', { encoding: 'utf8' })
        .split('\n')
        .some(line => line.includes('# web-finder-serve') && line.includes('--auto-publish'));
    } catch {}
  }
  return readAutoPublishedPorts().length > 0;
}

function isGitCheckout() {
  try {
    execSync('git rev-parse --is-inside-work-tree', { cwd: repoRoot, stdio: 'ignore' });
    return true;
  } catch {
    return false;
  }
}

function brewInstalled(kind, name) {
  try {
    execSync(`brew list --${kind} ${name}`, { stdio: 'ignore' });
    return true;
  } catch {
    return false;
  }
}

function updateWithHomebrew() {
  if (process.platform !== 'darwin' || !hasCommand('brew')) return false;

  const formulaInstalled = brewInstalled('formula', 'zeulewan/tap/web-finder') ||
                           brewInstalled('formula', 'web-finder');
  const caskInstalled = brewInstalled('cask', 'zeulewan/tap/webfinder') ||
                        brewInstalled('cask', 'webfinder');
  if (!formulaInstalled && !caskInstalled) return false;

  console.log('Updating WebFinder with Homebrew...');
  execSync('brew update', { stdio: 'inherit' });
  if (formulaInstalled) execSync('brew upgrade zeulewan/tap/web-finder', { stdio: 'inherit' });
  if (caskInstalled) execSync('brew upgrade --cask zeulewan/tap/webfinder', { stdio: 'inherit' });
  return true;
}

function isSynology() {
  return fs.existsSync('/etc/synoinfo.conf') || fs.existsSync('/usr/syno');
}

function isOpenWrt() {
  return process.platform === 'linux' &&
         (fs.existsSync('/etc/openwrt_release') || fs.existsSync('/etc/openwrt_version'));
}

function isRootUser() {
  return typeof process.getuid === 'function' && process.getuid() === 0;
}

function runAsRoot(command) {
  if (isRootUser()) {
    execSync(command, { encoding: 'utf8' });
    return;
  }
  if (hasCommand('sudo')) {
    execSync(`sudo sh -c ${quoteShell(command)}`, { stdio: 'inherit' });
    return;
  }
  if (hasCommand('doas')) {
    execSync(`doas sh -c ${quoteShell(command)}`, { stdio: 'inherit' });
    return;
  }
  throw new Error('OpenWrt service setup needs root. Re-run this command as root, or install sudo/doas.');
}

function writeFileAsRoot(dest, content, mode = '755') {
  if (isRootUser()) {
    fs.writeFileSync(dest, content, { mode: parseInt(mode, 8) });
    fs.chmodSync(dest, parseInt(mode, 8));
    return;
  }
  const tmp = path.join(os.tmpdir(), `web-finder-${process.pid}`);
  fs.writeFileSync(tmp, content);
  try {
    runAsRoot(`cp ${quoteShell(tmp)} ${quoteShell(dest)} && chmod ${mode} ${quoteShell(dest)}`);
  } finally {
    try { fs.unlinkSync(tmp); } catch {}
  }
}

function unlinkAsRoot(dest) {
  if (isRootUser()) {
    try { fs.unlinkSync(dest); } catch {}
    return;
  }
  runAsRoot(`rm -f ${quoteShell(dest)}`);
}

function quoteRcArg(str) {
  return `'${String(str).replace(/'/g, "'\\''")}'`;
}

function xmlEscape(str) {
  return String(str)
    .replace(/&/g, '&amp;')
    .replace(/</g, '&lt;')
    .replace(/>/g, '&gt;')
    .replace(/"/g, '&quot;')
    .replace(/'/g, '&apos;');
}

function quoteSystemdArg(str) {
  return `"${String(str).replace(/([\\"])/g, '\\$1')}"`;
}

function pidfileStatus(pidfile) {
  const installed = fs.existsSync(pidfile);
  const pid = installed ? fs.readFileSync(pidfile, 'utf8').trim() : null;
  if (pid) {
    try {
      if (pidMatchesWebFinder(pid)) return { installed: true, active: true, pid };
    } catch {}
  }
  return { installed, active: false, pid: null };
}

function pidMatchesWebFinder(pid) {
  if (!/^\d+$/.test(String(pid))) return false;
  try {
    process.kill(Number(pid), 0);
    const procCmdline = `/proc/${pid}/cmdline`;
    const command = fs.existsSync(procCmdline)
      ? fs.readFileSync(procCmdline, 'utf8').replace(/\0/g, ' ')
      : execFileSync('ps', ['-p', String(pid), '-o', 'command='], { encoding: 'utf8' });
    return command.includes('web-finder') && command.includes('serve');
  } catch {
    return false;
  }
}

function stopPidfileProcess(pidfile) {
  if (!fs.existsSync(pidfile)) return;
  const pid = fs.readFileSync(pidfile, 'utf8').trim();
  if (pidMatchesWebFinder(pid)) {
    try { process.kill(Number(pid), 'SIGTERM'); } catch {}
  }
  fs.unlinkSync(pidfile);
}

function removeCronAutostartMarker() {
  const marker = '# web-finder-serve';
  if (!hasCommand('crontab')) return;
  let existing = '';
  try { existing = execSync('crontab -l 2>/dev/null', { encoding: 'utf8' }); } catch {}
  const next = existing
    .split('\n')
    .filter(line => line.trim() && !line.includes(marker))
    .join('\n');
  const tmp = path.join(os.tmpdir(), `web-finder-cron-${process.pid}`);
  fs.writeFileSync(tmp, next ? `${next}\n` : '');
  execSync(`crontab ${quoteShell(tmp)}`, { encoding: 'utf8' });
  fs.unlinkSync(tmp);
}

function versionString() {
  let commit = '';
  try {
    if (fs.existsSync(path.join(repoRoot, '.git'))) {
      commit = execSync('git rev-parse --short HEAD', { cwd: repoRoot, encoding: 'utf8' }).trim();
    }
  } catch {}
  return commit ? `${pkg.version} (${commit})` : pkg.version;
}

function serviceStatus() {
  const info = getAutostartInfo();
  if (info.type === 'launchd') {
    try {
      const out = execSync(`launchctl print gui/${process.getuid()}/com.zeul.web-finder-serve`, { encoding: 'utf8' });
      const pid = out.match(/\bpid = (\d+)/)?.[1] || null;
      const running = /\bstate = running\b/.test(out) || Boolean(pid);
      return { installed: true, active: running, pid };
    } catch {
      return { installed: fs.existsSync(info.plist), active: false, pid: null };
    }
  }

  if (info.type === 'cron') {
    const status = pidfileStatus(info.pidfile);
    if (status.installed) return status;
    try {
      const installed = execSync('crontab -l', { encoding: 'utf8' }).includes('# web-finder-serve');
      return { installed, active: false, pid: null };
    } catch {
      return status;
    }
  }

  if (info.type === 'procd') {
    const installed = fs.existsSync(info.init);
    let active = false;
    try {
      execSync(`${quoteShell(info.init)} running`, { stdio: 'ignore' });
      active = true;
    } catch {
      try {
        const out = execSync(`${quoteShell(info.init)} status`, { encoding: 'utf8' });
        active = !/not running|inactive|stopped/i.test(out);
      } catch {}
    }
    if (active) return { installed: true, active: true, pid: null };
    const legacy = pidfileStatus(info.pidfile);
    return { installed: installed || legacy.installed, active: legacy.active, pid: legacy.pid };
  }

  const installed = fs.existsSync(info.unit);
  try {
    const active = execSync('systemctl --user is-active web-finder-serve', { encoding: 'utf8' }).trim();
    let pid = null;
    try {
      const rawPid = execSync('systemctl --user show -p MainPID --value web-finder-serve', { encoding: 'utf8' }).trim();
      pid = rawPid && rawPid !== '0' ? rawPid : null;
    } catch {}
    return { installed: true, active: active === 'active', pid };
  } catch {
    return { installed, active: false, pid: null };
  }
}

function tailscaleServeStatus() {
  try {
    const json = execTailscale(['serve', 'status', '--json']);
    const routes = parseTailscaleServeStatusJSON(json);
    let out = '';
    try { out = execTailscale(['serve', 'status']).trim(); } catch {}
    return {
      available: true,
      active: routes.some(route => route.backendPort === MANIFEST_PORT),
      raw: out,
      routes,
    };
  } catch (e) {
    return { available: false, active: false, error: e.message };
  }
}

function fetchLocalManifest() {
  return new Promise((resolve) => {
    const req = http.get({
      hostname: '127.0.0.1',
      port: MANIFEST_PORT,
      path: MANIFEST_PATH,
      timeout: 8000,
    }, (res) => {
      let body = '';
      res.setEncoding('utf8');
      res.on('data', chunk => { body += chunk; });
      res.on('end', () => {
        if (res.statusCode !== 200) {
          resolve({ ok: false, error: `HTTP ${res.statusCode}` });
          return;
        }
        try {
          resolve({ ok: true, manifest: JSON.parse(body) });
        } catch (e) {
          resolve({ ok: false, error: e.message });
        }
      });
    });
    req.on('timeout', () => req.destroy(new Error('timeout')));
    req.on('error', e => resolve({ ok: false, error: e.message }));
  });
}

function tcpReachable(host, port, timeoutMs = 500) {
  return new Promise((resolve) => {
    if (!host || !port) {
      resolve(null);
      return;
    }
    const socket = net.createConnection({
      host: host === 'localhost' ? '127.0.0.1' : host,
      port,
    });
    let settled = false;
    const finish = (value) => {
      if (settled) return;
      settled = true;
      socket.destroy();
      resolve(value);
    };
    socket.setTimeout(timeoutMs, () => finish(false));
    socket.once('connect', () => finish(true));
    socket.once('error', () => finish(false));
  });
}

async function serveDriftStatus(serve, manifest) {
  if (!serve.available) return null;

  const routes = serve.routes || parseTailscaleServeStatus(serve.raw);
  const serviceRoutes = routes.filter(route => route.backendPort !== MANIFEST_PORT);
  const advertisedPorts = new Set((manifest.ok ? manifest.manifest.services || [] : [])
    .map(service => service.port)
    .filter(Number.isInteger));
  const managedPorts = new Set(readAutoPublishedPorts());
  const health = await Promise.all(serviceRoutes.map(route =>
    tcpReachable(route.backendHost, route.backendPort)));
  const inspected = serviceRoutes.map((route, index) => ({
    ...route,
    advertised: advertisedPorts.has(route.externalPort),
    managed: managedPorts.has(route.externalPort),
    reachable: health[index],
  }));
  const mappedPorts = new Set(serviceRoutes.map(route => route.externalPort));

  return {
    total: routes.length,
    serviceCount: serviceRoutes.length,
    manifestCount: routes.length - serviceRoutes.length,
    managedCount: inspected.filter(route => route.managed).length,
    hidden: inspected.filter(route => !route.advertised),
    dead: inspected.filter(route => route.reachable === false),
    unmanaged: inspected.filter(route => !route.managed),
    trackedMissing: Array.from(managedPorts).filter(port => !mappedPorts.has(port)).sort((a, b) => a - b),
  };
}

async function magicDnsStatus() {
  try {
    const status = JSON.parse(execTailscale(['status', '--json']));
    const backendWarning = tailscaleBackendWarning(status);
    if (backendWarning) return { available: false, ok: false, warning: backendWarning };
    const dnsName = status.Self?.DNSName;
    if (!dnsName) return { available: true, ok: false, warning: 'Tailscale DNSName unavailable.' };
    try {
      await dns.lookup(dnsName);
      return { available: true, ok: true, dnsName };
    } catch {
      return {
        available: true,
        ok: false,
        dnsName,
        warning: 'Tailscale MagicDNS is not resolving on this machine; run `tailscale set --accept-dns=true` for clickable .ts.net links.',
      };
    }
  } catch (e) {
    return { available: false, ok: false, warning: `Tailscale status unavailable: ${e.message}` };
  }
}

async function printStatus({ debug = false, json = false } = {}) {
  const svc = serviceStatus();
  const serve = tailscaleServeStatus();
  const manifest = await fetchLocalManifest();
  const magicDns = await magicDnsStatus();
  const drift = await serveDriftStatus(serve, manifest);

  if (json) {
    console.log(JSON.stringify({
      version: versionString(),
      daemon: { ...svc, autoPublish: autostartUsesAutoPublish() },
      manifest,
      tailscaleServe: {
        available: serve.available,
        active: serve.active,
        routes: serve.routes || [],
        ...(serve.error ? { error: serve.error } : {}),
      },
      magicDNS: magicDns,
      drift,
      config: { path: configPath(), error: loadConfig().error },
    }, null, 2));
    return;
  }

  console.log(`web-finder ${versionString()}`);
  console.log(`Daemon: ${svc.active ? `running${svc.pid ? ` (pid ${svc.pid})` : ''}` : svc.installed ? 'installed but not running' : 'not installed'}`);
  console.log(`Manifest: ${manifest.ok ? `available at http://127.0.0.1:${MANIFEST_PORT}${MANIFEST_PATH}` : `unavailable (${manifest.error})`}`);
  console.log(`Tailscale Serve: ${serve.active ? 'enabled' : serve.available ? 'not enabled' : 'unavailable'}`);
  console.log(`MagicDNS: ${magicDns.ok ? `working (${magicDns.dnsName})` : magicDns.available ? 'not resolving' : 'unavailable'}`);
  if (magicDns.warning) console.log(`Warning: ${magicDns.warning}`);

  if (manifest.ok) {
    const services = manifest.manifest.services || [];
    console.log(`Advertised services: ${services.length}`);
    for (const service of services) {
      console.log(`  - ${service.name || `:${service.port}`} ${service.url}`);
    }
  }

  if (drift) {
    console.log(`Serve routes: ${drift.total} total (${drift.serviceCount} services, ${drift.manifestCount} manifest)`);
    console.log(`Managed service routes: ${drift.managedCount}`);
    const clean = drift.hidden.length === 0 && drift.dead.length === 0 &&
      drift.unmanaged.length === 0 && drift.trackedMissing.length === 0;
    if (clean) {
      console.log('Route drift: clean');
    } else {
      console.log(`Route drift: ${drift.hidden.length} hidden, ${drift.dead.length} dead, ${drift.unmanaged.length} unmanaged, ${drift.trackedMissing.length} tracked but missing`);
      const driftedRoutes = drift.hidden
        .concat(drift.dead, drift.unmanaged)
        .filter((route, index, all) => all.findIndex(item =>
          item.externalPort === route.externalPort && item.target === route.target) === index);
      const shown = debug ? driftedRoutes : driftedRoutes.slice(0, 12);
      for (const route of shown) {
        const reasons = [];
        if (!route.advertised) reasons.push('hidden');
        if (route.reachable === false) reasons.push('dead backend');
        if (!route.managed) reasons.push('unmanaged');
        console.log(`  - :${route.externalPort} -> ${route.target} (${reasons.join(', ')})`);
      }
      if (!debug && driftedRoutes.length > shown.length) {
        console.log(`  ... ${driftedRoutes.length - shown.length} more; run web-finder diagnose for all routes`);
      }
      if (drift.trackedMissing.length > 0) {
        console.log(`  - tracked but missing: ${drift.trackedMissing.map(port => `:${port}`).join(', ')}`);
      }
    }
  }

  if (debug && serve.raw) {
    console.log('\nTailscale Serve status:');
    console.log(serve.raw);
  }
}

// MARK: - Autostart helpers

function getAutostartInfo() {
  const nodeCommand = autostartNodeCommand();
  const binPath  = preferredBinPath();
  if (process.platform === 'darwin') {
    return {
      type: 'launchd',
      plist: path.join(os.homedir(), 'Library', 'LaunchAgents', 'com.zeul.web-finder-serve.plist'),
      nodeCommand, binPath,
    };
  }
  if (isOpenWrt()) {
    return {
      type: 'procd',
      init: '/etc/init.d/web-finder',
      pidfile: path.join(os.homedir(), '.web-finder-serve.pid'),
      nodeCommand, binPath,
    };
  }
  if (isSynology() || !hasCommand('systemctl')) {
    return {
      type: 'cron',
      pidfile: path.join(os.homedir(), '.web-finder-serve.pid'),
      nodeCommand, binPath,
    };
  }
  return {
    type: 'systemd',
    unit: path.join(os.homedir(), '.config', 'systemd', 'user', 'web-finder-serve.service'),
    nodeCommand, binPath,
  };
}

function setupTailscaleServe({ autoPublish = false } = {}) {
  try {
    const routes = parseTailscaleServeStatusJSON(execTailscale(['serve', 'status', '--json']));
    const existing = routes.find(route => route.externalPort === MANIFEST_PORT && route.path === '/');
    const target = `http://127.0.0.1:${MANIFEST_PORT}`;
    if (existing && existing.target !== target) {
      console.error(`Tailscale Serve setup skipped: preserving existing :${MANIFEST_PORT}/ -> ${existing.target}`);
      return false;
    }
    execTailscale(['serve', '--bg', `--https=${MANIFEST_PORT}`, `http://127.0.0.1:${MANIFEST_PORT}`]);
    console.log('Tailscale Serve enabled for tailnet-only manifest access.');
    return true;
  } catch (e) {
    if (isTailscaleServePermissionError(e)) {
      printTailscaleServePermissionHelp({ autoPublish });
      return false;
    }
    console.error('Tailscale Serve setup skipped:', e.message);
    return false;
  }
}

async function syncTailscaleServeServices({ showAll = false, dryRun = false, quiet = false, graceMs = 5 * 60 * 1000 } = {}) {
  const existingRoutes = await getTailscaleServeRoutes();
  const loaded = loadConfig();
  if (loaded.error && !quiet) console.error(`Config ignored (${loaded.file}): ${loaded.error}`);
  const scanned = await scanLocalSS({ showAll });
  const services = applyServiceConfig(scanned, loaded.config, { forPublish: true })
    .filter(service => service.port && service.port !== MANIFEST_PORT);
  const plan = planServeReconciliation({
    existingRoutes,
    desiredServices: services,
    state: readAutoPublishState(),
    graceMs,
  });

  if (!quiet) {
    for (const conflict of plan.conflicts) {
      const wanted = conflict.desired ? `; wanted ${conflict.desired.target}` : '';
      console.error(`Preserving existing route :${conflict.current.externalPort}${conflict.current.path} -> ${conflict.current.target}${wanted}${conflict.reason ? ` (${conflict.reason})` : ''}`);
    }
  }
  if (dryRun) return { plan, services };

  const removed = [];
  for (const route of plan.remove) {
    try {
      execTailscale(['serve', `--${route.externalScheme || 'https'}=${route.externalPort}`, 'off']);
      removed.push(route);
    } catch (error) {
      plan.nextState.routes.push(route);
      if (!quiet) console.error(`Could not remove owned route :${route.externalPort}: ${error.message}`);
    }
  }
  const created = [];
  for (const route of plan.create) {
    try {
      execTailscale(['serve', '--bg', `--https=${route.externalPort}`, route.target]);
      created.push(route);
    } catch (error) {
      plan.nextState.routes = plan.nextState.routes.filter(owned => owned.externalPort !== route.externalPort);
      if (!quiet) console.error(`Tailscale Serve setup skipped for :${route.externalPort}: ${error.message}`);
    }
  }
  writeAutoPublishState(plan.nextState);
  if (!quiet && (created.length > 0 || removed.length > 0)) {
    console.log(`Tailscale Serve reconciled: ${created.length} added or updated, ${removed.length} removed.`);
  }
  return { plan, services };
}

function removeTailscaleServe({ removeAutoPublished = false } = {}) {
  if (removeAutoPublished) {
    let existingRoutes = [];
    try {
      existingRoutes = parseTailscaleServeStatusJSON(execTailscale(['serve', 'status', '--json']));
      if (existingRoutes.length === 0) existingRoutes = parseTailscaleServeStatus(execTailscale(['serve', 'status']));
    } catch {}
    const plan = planServeReconciliation({
      existingRoutes,
      desiredServices: [],
      state: readAutoPublishState(),
      graceMs: 0,
    });
    const remaining = [];
    for (const route of plan.remove) {
      try {
        execTailscale(['serve', `--${route.externalScheme || 'https'}=${route.externalPort}`, 'off']);
      } catch {
        remaining.push(route);
      }
    }
    writeAutoPublishState({ version: 2, routes: remaining });
  }
  try {
    const routes = parseTailscaleServeStatusJSON(execTailscale(['serve', 'status', '--json']));
    const manifestRoute = routes.find(route =>
      route.externalPort === MANIFEST_PORT &&
      route.path === '/' &&
      route.target === `http://127.0.0.1:${MANIFEST_PORT}`);
    if (manifestRoute) {
      execTailscale(['serve', `--${manifestRoute.externalScheme || 'https'}=${MANIFEST_PORT}`, 'off']);
      console.log('Tailscale Serve disabled.');
    }
  } catch {}
}

function setupAutostart({ autoPublish = false } = {}) {
  const info = getAutostartInfo();
  const serveArgs = autoPublish
    ? ['serve', '--host', '127.0.0.1', '--auto-publish']
    : ['serve', '--host', '127.0.0.1'];
  try {
    if (info.type === 'launchd') {
      const xml = `<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key><string>com.zeul.web-finder-serve</string>
    <key>EnvironmentVariables</key>
    <dict>
        <key>PATH</key><string>${LAUNCHD_PATH}</string>
    </dict>
    <key>ProgramArguments</key>
    <array>
        ${info.nodeCommand.map(arg => `<string>${xmlEscape(arg)}</string>`).join('\n        ')}
        <string>${xmlEscape(info.binPath)}</string>
        ${serveArgs.map(arg => `<string>${xmlEscape(arg)}</string>`).join('\n        ')}
    </array>
    <key>AssociatedBundleIdentifiers</key>
    <array><string>com.zeul.web-finder</string></array>
    <key>RunAtLoad</key><true/>
    <key>KeepAlive</key><true/>
    <key>StandardOutPath</key><string>/tmp/web-finder-serve.log</string>
    <key>StandardErrorPath</key><string>/tmp/web-finder-serve.log</string>
</dict>
</plist>`;
      fs.mkdirSync(path.dirname(info.plist), { recursive: true });
      fs.writeFileSync(info.plist, xml);
      try { execSync(`launchctl unload "${info.plist}" 2>/dev/null`, { encoding: 'utf8' }); } catch {}
      execSync(`launchctl load "${info.plist}"`, { encoding: 'utf8' });
      console.log('Autostart enabled (LaunchAgent).');
    } else if (info.type === 'cron') {
      const marker = '# web-finder-serve';
      if (hasCommand('crontab')) {
        const cronLine = `@reboot ${info.nodeCommand.map(quoteShell).join(' ')} ${quoteShell(info.binPath)} ${serveArgs.map(quoteShell).join(' ')} >> /tmp/web-finder-serve.log 2>&1 ${marker}`;
        let existing = '';
        try { existing = execSync('crontab -l 2>/dev/null', { encoding: 'utf8' }); } catch {}
        const next = existing
          .split('\n')
          .filter(line => line.trim() && !line.includes(marker))
          .concat(cronLine)
          .join('\n') + '\n';
        const tmp = path.join(os.tmpdir(), `web-finder-cron-${process.pid}`);
        fs.writeFileSync(tmp, next);
        execSync(`crontab ${quoteShell(tmp)}`, { encoding: 'utf8' });
        fs.unlinkSync(tmp);
        console.log('Autostart enabled (cron).');
      } else {
        console.log('Autostart unavailable: crontab not found; starting for current boot only.');
      }
      if (fs.existsSync(info.pidfile)) {
        const pid = fs.readFileSync(info.pidfile, 'utf8').trim();
        if (pid) {
          try { execSync(`kill ${pid}`, { encoding: 'utf8' }); } catch {}
        }
      }
      const startCmd = `nohup ${info.nodeCommand.map(quoteShell).join(' ')} ${quoteShell(info.binPath)} ${serveArgs.map(quoteShell).join(' ')} >> /tmp/web-finder-serve.log 2>&1 & echo $! > ${quoteShell(info.pidfile)}`;
      execSync(startCmd, { encoding: 'utf8' });
      console.log('Manifest server started.');
    } else if (info.type === 'procd') {
      removeCronAutostartMarker();
      stopPidfileProcess(info.pidfile);
      const commandArgs = info.nodeCommand.concat([info.binPath], serveArgs);
      const rcCommand = commandArgs.map(quoteRcArg).join(' ');
      const script = `#!/bin/sh /etc/rc.common
USE_PROCD=1
START=95

start_service() {
  procd_open_instance
  procd_set_param command ${rcCommand}
  procd_set_param env HOME=${quoteRcArg(os.homedir())}
  procd_set_param respawn
  procd_set_param stdout 1
  procd_set_param stderr 1
  procd_close_instance
}
`;
      writeFileAsRoot(info.init, script);
      runAsRoot(`${quoteShell(info.init)} enable`);
      runAsRoot(`${quoteShell(info.init)} stop >/dev/null 2>&1 || true`);
      runAsRoot(`${quoteShell(info.init)} start`);
      console.log('Autostart enabled (procd).');
    } else {
      const unit = `[Unit]
Description=web-finder manifest server

[Service]
ExecStart=${info.nodeCommand.concat([info.binPath], serveArgs).map(quoteSystemdArg).join(' ')}
Restart=on-failure
RestartSec=5

[Install]
WantedBy=default.target
`;
      fs.mkdirSync(path.dirname(info.unit), { recursive: true });
      fs.writeFileSync(info.unit, unit);
      execSync('systemctl --user daemon-reload', { encoding: 'utf8' });
      execSync('systemctl --user enable --now web-finder-serve', { encoding: 'utf8' });
      execSync('systemctl --user restart web-finder-serve', { encoding: 'utf8' });
      console.log('Autostart enabled (systemd).');
    }
    return setupTailscaleServe({ autoPublish });
  } catch (e) {
    console.error('Autostart setup failed:', e.message);
    return false;
  }
}

function removeAutostart() {
  const info = getAutostartInfo();
  try {
    if (info.type === 'launchd') {
      if (fs.existsSync(info.plist)) {
        try { execSync(`launchctl unload "${info.plist}"`, { encoding: 'utf8' }); } catch {}
        fs.unlinkSync(info.plist);
        console.log('Autostart disabled.');
      } else {
        console.log('Autostart was not enabled.');
      }
    } else if (info.type === 'cron') {
      removeCronAutostartMarker();
      stopPidfileProcess(info.pidfile);
      console.log('Autostart disabled.');
    } else if (info.type === 'procd') {
      removeCronAutostartMarker();
      stopPidfileProcess(info.pidfile);
      if (fs.existsSync(info.init)) {
        try { runAsRoot(`${quoteShell(info.init)} stop`); } catch {}
        try { runAsRoot(`${quoteShell(info.init)} disable`); } catch {}
        unlinkAsRoot(info.init);
        console.log('Autostart disabled.');
      } else {
        console.log('Autostart was not enabled.');
      }
    } else {
      try { execSync('systemctl --user disable --now web-finder-serve', { encoding: 'utf8' }); } catch {}
      if (fs.existsSync(info.unit)) fs.unlinkSync(info.unit);
      try { execSync('systemctl --user daemon-reload', { encoding: 'utf8' }); } catch {}
      console.log('Autostart disabled.');
    }
    removeTailscaleServe({ removeAutoPublished: true });
  } catch (e) {
    console.error('Failed to disable autostart:', e.message);
  }
}

const args = process.argv.slice(2);
const command = args.find(a => !a.startsWith('-')) || '';
const autoPublishMode = args.includes('--auto-publish');

if (command === 'version' || args.includes('--version') || args.includes('-v')) {
  console.log(versionString());
  process.exit(0);
}

if (command === 'update' || args.includes('--update') || args.includes('-u')) {
  const preserveAutoPublish = autoPublishMode || (!args.includes('--passive') && autostartUsesAutoPublish());
  if (isGitCheckout()) {
    console.log('Updating web-finder CLI...');
    try {
      const out = execSync('git pull --ff-only', { cwd: repoRoot, encoding: 'utf8' });
      process.stdout.write(out);
    } catch (e) {
      console.error('Update failed:', e.message);
      process.exit(1);
    }

    // On macOS, also update the desktop app if installed. Prefer the checked-out
    // repo so CLI/app fixes stay in lockstep without waiting for a release zip.
    if (process.platform === 'darwin') {
      const userApps  = path.join(os.homedir(), 'Applications', 'WebFinder.app');
      const sysApps   = '/Applications/WebFinder.app';
      const appPath   = fs.existsSync(sysApps) ? sysApps : fs.existsSync(userApps) ? userApps : null;
      const installDir = fs.existsSync(sysApps) || fs.existsSync('/Applications')
        ? '/Applications'
        : path.join(os.homedir(), 'Applications');

      try {
        const macosDir = path.join(repoRoot, '..', 'macos');
        const buildScript = path.join(macosDir, 'build.sh');
        const builtApp = path.join(macosDir, 'WebFinder.app');
        if (fs.existsSync(buildScript)) {
          console.log('Building WebFinder.app from checked-out repo...');
          execSync('./build.sh', { cwd: macosDir, stdio: 'inherit' });
          fs.mkdirSync(installDir, { recursive: true });
          execSync(`rm -rf "${path.join(installDir, 'WebFinder.app')}" && cp -R "${builtApp}" "${installDir}/"`, { stdio: 'inherit' });
          console.log(`WebFinder.app installed in ${installDir}.`);
          console.log('Restart the app to use the updated build.');
        } else {
          const installed = appPath
            ? execSync(`defaults read "${appPath}/Contents/Info.plist" CFBundleShortVersionString`, { encoding: 'utf8' }).trim()
            : '0';
          const redirect = execSync('curl -sI -o /dev/null -w "%{url_effective}" -L https://github.com/zeulewan/web-finder/releases/latest', { encoding: 'utf8' }).trim();
          const latest = redirect.match(/\/tag\/v?(.+)$/)?.[1] || '';
          if (installed === latest) {
            console.log(`WebFinder.app already up to date (${installed}).`);
          } else {
            const appUrl = 'https://github.com/zeulewan/web-finder/releases/latest/download/WebFinder.app.zip';
            const tmpZip = path.join(repoRoot, 'WebFinder.app.zip');
            console.log(`Updating WebFinder.app ${installed} -> ${latest}...`);
            execSync(`curl -fsSL -o "${tmpZip}" "${appUrl}"`, { encoding: 'utf8' });
            fs.mkdirSync(installDir, { recursive: true });
            execSync(`rm -rf "${path.join(installDir, 'WebFinder.app')}" && unzip -q "${tmpZip}" -d "${installDir}"`, { stdio: 'inherit' });
            fs.unlinkSync(tmpZip);
            console.log(`WebFinder.app updated in ${installDir}.`);
          }
        }
      } catch (e) {
        console.error('App update failed:', e.message);
      }
    }
  } else if (!updateWithHomebrew()) {
    console.error('Update failed: this install is not a git checkout. Use your package manager or reinstall WebFinder.');
    process.exit(1);
  }

  if (preserveAutoPublish && !ensureLinuxAutoPublishPermission()) process.exit(1);

  // Set up autostart as part of every update
  if (!setupAutostart({ autoPublish: preserveAutoPublish })) process.exit(1);

  process.exit(0);
}

if (command === 'start') {
  if (autoPublishMode && !ensureLinuxAutoPublishPermission()) process.exit(1);
  process.exit(setupAutostart({ autoPublish: autoPublishMode }) ? 0 : 1);
}

if (command === 'stop') {
  removeAutostart();
  process.exit(0);
}

if (command === 'config') {
  const loaded = loadConfig();
  console.log(`Config: ${loaded.file}`);
  if (loaded.error) {
    console.error(`Invalid config: ${loaded.error}`);
    process.exit(1);
  }
  console.log(JSON.stringify(loaded.config, null, 2));
  process.exit(0);
}

if (command === 'qr' || command === 'publisher-url') {
  const url = publisherURL();
  if (!url) {
    console.error('Could not determine this device\'s Tailscale publisher URL. Check `tailscale status`.');
    process.exit(1);
  }
  console.log(url);
  if (command === 'qr' && hasCommand('qrencode') && process.stdout.isTTY) {
    try { execSync(`qrencode -t ANSIUTF8 ${quoteShell(url)}`, { stdio: 'inherit' }); } catch {}
  } else if (command === 'qr' && process.stdout.isTTY) {
    console.log('Install `qrencode` to print a scannable terminal QR code. You can paste the URL into the iPhone app now.');
  }
  process.exit(0);
}

if (command === 'reconcile') {
  const apply = args.includes('--apply');
  const graceIdx = args.indexOf('--grace-seconds');
  const graceSeconds = graceIdx >= 0 ? Number(args[graceIdx + 1]) : (apply ? 300 : 0);
  if (!Number.isFinite(graceSeconds) || graceSeconds < 0) {
    console.error('--grace-seconds must be a non-negative number');
    process.exit(1);
  }
  syncTailscaleServeServices({ showAll: args.includes('--debug'), dryRun: !apply, graceMs: graceSeconds * 1000 })
    .then(({ plan, services }) => {
      const summary = {
        mode: apply ? 'applied' : 'dry-run',
        detectedServices: services.length,
        create: plan.create,
        remove: plan.remove,
        conflicts: plan.conflicts,
        preserved: plan.preserved,
      };
      if (args.includes('--json') || args.includes('-j')) {
        console.log(JSON.stringify(summary, null, 2));
      } else {
        console.log(`Reconcile ${summary.mode}: ${summary.detectedServices} services, ${plan.create.length} add/update, ${plan.remove.length} remove, ${plan.conflicts.length} conflicts.`);
        for (const route of plan.create) console.log(`  + :${route.externalPort}${route.path} -> ${route.target}`);
        for (const route of plan.remove) console.log(`  - :${route.externalPort}${route.path} -> ${route.target}`);
      }
      process.exit(plan.conflicts.length > 0 ? 2 : 0);
    })
    .catch(error => {
      console.error('Reconcile failed:', error.message);
      process.exit(1);
    });
  return;
}

if (command === 'status' || command === 'diagnose') {
  printStatus({ debug: command === 'diagnose' || args.includes('--debug'), json: args.includes('--json') || args.includes('-j') })
    .then(() => process.exit(0))
    .catch((e) => {
      console.error('Status failed:', e.message);
      process.exit(1);
    });
  return;
}

if (args[0] === 'autostart') {
  const sub = args[1];
  if (sub === 'on' || sub === 'enable') {
    if (autoPublishMode && !ensureLinuxAutoPublishPermission()) process.exit(1);
    if (!setupAutostart({ autoPublish: autoPublishMode })) process.exit(1);
  } else if (sub === 'off' || sub === 'disable') {
    removeAutostart();
  } else {
    console.log('Usage: web-finder autostart on|off');
  }
  process.exit(0);
}

if (args[0] === 'serve') {
  const portIdx  = args.indexOf('--port');
  const hostIdx  = args.indexOf('--host');
  const noTsServe = args.includes('--no-tailscale-serve');
  const autoPublish = args.includes('--auto-publish');
  const servePort = portIdx !== -1 ? parseInt(args[portIdx + 1]) : MANIFEST_PORT;
  const serveHost = hostIdx !== -1 ? args[hostIdx + 1] : (process.env.WEB_FINDER_HOST || '127.0.0.1');
  const showAll  = args.includes('--debug') || args.includes('--all') || args.includes('-a');
  const cacheMs = 15000;
  const staleKeepMs = 5 * 60 * 1000;
  let manifestCache = null;
  let manifestLastRefreshAt = 0;
  let manifestReducedSince = 0;
  let manifestRefresh = null;
  let globalManifestCache = null;
  let globalManifestLastRefreshAt = 0;
  let globalManifestRefresh = null;

  async function buildManifest() {
    if (autoPublish && serveHost === '127.0.0.1' && !noTsServe) {
      await syncTailscaleServeServices({ showAll });
    }
    const loaded = loadConfig();
    const services = applyServiceConfig(
      await scanLocalSS({ showAll, tailnetOnly: true }),
      loaded.config,
      { forPublish: true },
    );
    return {
      version:  1,
      hostname: os.hostname(),
      services: services
        .filter(s => s.port !== MANIFEST_PORT)
        .map(s => {
          const service = { name: s.title, port: s.port, url: s.url };
          if (s.directoryListing) service.directoryListing = true;
          return service;
        }),
    };
  }

  async function refreshManifestCache() {
    if (manifestRefresh) return manifestRefresh;
    manifestRefresh = buildManifest()
      .then((manifest) => {
        const now = Date.now();
        const oldCount = manifestCache?.services?.length || 0;
        const newCount = manifest.services.length;
        manifestLastRefreshAt = now;
        if (manifestCache && newCount < oldCount) {
          if (!manifestReducedSince) manifestReducedSince = now;
          if (now - manifestReducedSince < staleKeepMs) return manifestCache;
        } else {
          manifestReducedSince = 0;
        }
        manifestCache = manifest;
        return manifestCache;
      })
      .finally(() => { manifestRefresh = null; });
    return manifestRefresh;
  }

  async function buildGlobalManifest() {
    const [local, remote] = await Promise.all([buildManifest(), scanTailscale({ showAll })]);
    let selfName = os.hostname();
    let selfHost = '127.0.0.1';
    try {
      const status = JSON.parse(execTailscale(['status', '--json']));
      selfName = status?.Self?.HostName || selfName;
      selfHost = String(status?.Self?.DNSName || '').replace(/\.$/, '') ||
        (status?.Self?.TailscaleIPs || []).find(candidate => !candidate.includes(':')) || selfHost;
    } catch {}
    const localServices = local.services.map(service => {
      try {
        const url = new URL(service.url);
        if (url.hostname === '127.0.0.1' || url.hostname === 'localhost') url.hostname = selfHost;
        return { ...service, url: url.toString() };
      } catch {
        return service;
      }
    });
    const devices = [{
      name: selfName,
      host: selfHost,
      os: process.platform,
      online: true,
      services: localServices,
    }].concat((remote.peers || []).map(peer => ({
      name: peer.name,
      host: peer.dnsName || peer.ip,
      os: peer.os,
      online: Boolean(peer.online),
      services: (peer.services || []).map(service => ({
        name: service.title,
        port: service.port,
        url: service.url,
        ...(service.directoryListing ? { directoryListing: true } : {}),
      })),
    })));
    return { version: 1, generatedAt: new Date().toISOString(), devices };
  }

  async function refreshGlobalManifestCache() {
    if (globalManifestRefresh) return globalManifestRefresh;
    globalManifestRefresh = buildGlobalManifest()
      .then(manifest => {
        globalManifestCache = manifest;
        globalManifestLastRefreshAt = Date.now();
        return manifest;
      })
      .finally(() => { globalManifestRefresh = null; });
    return globalManifestRefresh;
  }

  const server = http.createServer(async (req, res) => {
    const requestPath = String(req.url || '').split('?')[0];
    if (requestPath !== MANIFEST_PATH && requestPath !== GLOBAL_MANIFEST_PATH) {
      res.writeHead(404, { 'Content-Type': 'text/plain' });
      res.end('Not found\n');
      return;
    }
    try {
      const isGlobal = requestPath === GLOBAL_MANIFEST_PATH;
      const manifest = isGlobal
        ? ((globalManifestCache && Date.now() - globalManifestLastRefreshAt < 30000)
            ? globalManifestCache
            : await refreshGlobalManifestCache())
        : ((manifestCache && Date.now() - manifestLastRefreshAt < cacheMs)
            ? manifestCache
            : await refreshManifestCache());
      res.writeHead(200, {
        'Content-Type':                'application/json',
        'Access-Control-Allow-Origin': '*',
        'Cache-Control':               'no-store',
      });
      res.end(JSON.stringify(manifest));
    } catch (e) {
      res.writeHead(500, { 'Content-Type': 'application/json' });
      res.end(JSON.stringify({ error: e.message }));
    }
  });

  server.listen(servePort, serveHost, () => {
    console.log(`web-finder manifest server listening on ${serveHost}:${servePort}`);
    console.log(`Endpoint: http://localhost:${servePort}${MANIFEST_PATH}`);
    if (servePort === MANIFEST_PORT) {
      const url = publisherURL();
      if (url) console.log(`iPhone publisher URL: ${url}`);
    }
    (async () => {
      if (serveHost === '127.0.0.1' && servePort === MANIFEST_PORT && !noTsServe) {
        setupTailscaleServe({ autoPublish });
      }
      await refreshManifestCache();
    })().catch(e => console.error('Initial manifest refresh failed:', e.message));
    console.log('Press Ctrl+C to stop.');
  });

  process.on('SIGTERM', () => server.close(() => process.exit(0)));
  // Keep running
  return;
}

if (args.includes('--help') || args.includes('-h')) {
  console.log(`
Usage: web-finder [command] [options]

Commands:
  web-finder              Find local services and Tailscale-published peer services
  web-finder start --auto-publish
                          Recommended: publish detected local web UIs with Tailscale Serve
  web-finder start        Passive default: advertise existing Tailscale Serve mappings
  web-finder stop         Stop sharing this machine and disable autostart
  web-finder status       Check daemon, Tailscale Serve, MagicDNS, and version
  web-finder reconcile --dry-run
                          Preview safe auto-publish route cleanup
  web-finder reconcile --apply
                          Apply only WebFinder-owned route changes
  web-finder reconcile --apply --grace-seconds 0
                          Apply cleanup immediately (useful for controlled tests)
  web-finder config       Show the service alias/exclusion config and path
  web-finder qr           Print the iPhone publisher URL and a QR when qrencode is installed
  web-finder update       Update WebFinder and restart sharing
  web-finder version      Show version

Options:
  --json, -j          Output as JSON for apps/scripts
  --debug             Show noisy diagnostics, all open ports, and no-service peers
  --auto-publish      With start/serve, publish detected local web UIs via Tailscale Serve
  --passive           With update, explicitly switch an existing publisher to passive mode
  --version, -v       Show version
  --help, -h          Show this help

By default, web-finder only shows machines that are actually serving something.
Recommended setup is web-finder start --auto-publish. It is not the default:
plain web-finder start only advertises services already exposed with Tailscale Serve.
On Linux, auto-publish may prompt to set local Tailscale operator permission.
Use --debug when you need the full/noisy view.

Examples:
  web-finder
  web-finder start --auto-publish
  web-finder start
  web-finder status
  web-finder --debug
  web-finder --json
`);
  process.exit(0);
}

const wantLocal     = args.includes('--local')     || args.includes('-l');
const wantTailscale = args.includes('--tailscale') || args.includes('-t');
const debugMode     = args.includes('--debug')     || args.includes('--all') || args.includes('-a');
const showAll       = debugMode;
const jsonMode      = args.includes('--json')      || args.includes('-j');

if (command && !['serve', 'autostart', 'config', 'reconcile'].includes(command)) {
  console.error(`Unknown command: ${command}`);
  console.error('Run `web-finder --help` for usage.');
  process.exit(1);
}

const doLocal     = wantLocal     || (!wantLocal && !wantTailscale);
const doTailscale = wantTailscale || (!wantLocal && !wantTailscale);

const isTTY = process.stdout.isTTY;
const dim   = isTTY ? '\x1b[2m' : '';
const reset = isTTY ? '\x1b[0m' : '';

function pad(str, len) {
  return str.length >= len ? str : str + ' '.repeat(len - str.length);
}

async function main() {
  const result = {};
  const tasks  = [];

  if (doLocal)     tasks.push(scanLocalSS({ showAll }).then(r   => { result.local     = r; }));
  if (doLocal)     tasks.push(scanGateway({ showAll }).then(r  => { result.gateway   = r; }));
  if (doTailscale) tasks.push(scanTailscale({ showAll }).then(r => { result.tailscale = r; }));
  await Promise.all(tasks);

  if (jsonMode) {
    console.log(JSON.stringify(result, null, 2));
    return;
  }

  if (result.local !== undefined) {
    console.log('\nLocal:');
    if (result.local.length === 0) {
      console.log('  (none found)');
    } else {
      for (const s of result.local) {
        console.log(`  \u25CF  ${pad(s.title, 28)} ${s.url}`);
      }
    }
  }

  if (result.gateway) {
    console.log(`\n${result.gateway.name}:`);
    for (const s of result.gateway.services) {
      console.log(`  \u25CF  ${pad(s.title, 28)} ${s.url}`);
    }
  }

  if (result.tailscale !== undefined) {
    console.log('\nTailscale:');
    if (result.tailscale.error) {
      console.log(`  Error: ${result.tailscale.error}`);
    } else if (!result.tailscale.peers || result.tailscale.peers.length === 0) {
      console.log('  (no peers)');
    } else {
      for (const warning of result.tailscale.warnings || []) {
        console.log(`  !  ${warning}`);
      }
      // Sort: has services first, then offline
      const sorted = [...result.tailscale.peers].sort((a, b) => {
        if (!a.online && b.online)  return 1;
        if (a.online  && !b.online) return -1;
        const as = (a.services || []).length;
        const bs = (b.services || []).length;
        if (as === 0 && bs > 0) return 1;
        if (as > 0 && bs === 0) return -1;
        return a.name.localeCompare(b.name);
      });
      const visible = debugMode ? sorted : sorted.filter(peer => peer.online && (peer.services || []).length > 0);

      if (visible.length === 0) {
        console.log('  (no services found)');
      }

      for (const peer of visible) {
        if (!peer.online) {
          console.log(`  \u25CB  ${peer.name}`);
        } else if (!peer.services || peer.services.length === 0) {
          console.log(`  \u25CE  ${peer.name}  ${dim}(no services)${reset}`);
        } else {
          for (const warning of peer.warnings || []) {
            console.log(`  !  ${peer.name}: ${warning}`);
          }
          for (const svc of peer.services) {
            console.log(`  \u25CF  ${pad(peer.name, 16)} ${pad(svc.title, 28)} ${svc.url}`);
          }
        }
      }
    }
  }

  console.log('');
}

main().catch(err => {
  console.error('Error:', err.message);
  process.exit(1);
});
