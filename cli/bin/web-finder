#!/usr/bin/env node
/**
 * web-finder - scan your Tailscale network for web interfaces
 *
 * Usage:
 *   web-finder                 # Scan local + Tailscale, human-readable
 *   web-finder start --auto-publish  # Recommended setup
 *   web-finder start                 # Passive default
 *                               # Also publish detected local web UIs
 *   web-finder stop            # Stop sharing and disable autostart
 *   web-finder status          # Check daemon, Tailscale Serve, DNS, version
 *   web-finder --json          # Machine-readable JSON output
 */

const path = require('path');
const fs   = require('fs');
const { execSync } = require('child_process');

// Resolve symlinks so scanner.js is found even when binary is symlinked to /usr/local/bin
const realBin  = fs.realpathSync(__filename);
const repoRoot = path.join(path.dirname(realBin), '..');
const { scanLocalSS, scanTailscale, scanGateway, getTailscaleServeMap, MANIFEST_PORT, MANIFEST_PATH } = require(path.join(repoRoot, 'scanner.js'));
const http = require('http');
const os   = require('os');
const dns  = require('dns').promises;

const AUTO_PUBLISH_STATE = path.join(os.homedir(), '.web-finder-auto-published-ports');
const LAUNCHD_PATH = '/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin';

const pkg  = JSON.parse(fs.readFileSync(path.join(repoRoot, 'package.json'), 'utf8'));
const TAILSCALE_PATHS = [
  'tailscale',
  '/Applications/Tailscale.app/Contents/MacOS/Tailscale',
  '/usr/local/bin/tailscale',
  '/opt/homebrew/bin/tailscale',
  '/volume1/@appstore/Tailscale/bin/tailscale',
];

function quoteShell(str) {
  return `"${String(str).replace(/"/g, '\\"')}"`;
}

function tailscaleCommand() {
  for (const candidate of TAILSCALE_PATHS) {
    if (candidate === 'tailscale') {
      try {
        const resolved = execSync('command -v tailscale', { encoding: 'utf8' }).trim();
        if (resolved) return resolved;
      } catch {}
    } else if (fs.existsSync(candidate)) {
      return candidate;
    }
  }
  return null;
}

function execTailscale(args, options = {}) {
  const cmd = tailscaleCommand();
  if (!cmd) throw new Error('tailscale command not found');
  return execSync(`${quoteShell(cmd)} ${args}`, { encoding: 'utf8', ...options });
}

function currentTailscaleOperator() {
  try {
    const prefs = JSON.parse(execTailscale('debug prefs'));
    return prefs.OperatorUser || '';
  } catch {
    return null;
  }
}

function promptYesNo(question) {
  if (!process.stdin.isTTY || !process.stdout.isTTY) return false;
  try {
    process.stdout.write(`${question} [y/N] `);
    const buf = Buffer.alloc(128);
    const bytes = fs.readSync(0, buf, 0, buf.length, null);
    const answer = buf.toString('utf8', 0, bytes).trim().toLowerCase();
    return answer === 'y' || answer === 'yes';
  } catch {
    return false;
  }
}

function tailscaleOperatorCommandForDisplay() {
  return 'sudo tailscale set --operator=$USER';
}

function printAutoPublishPermissionInstructions() {
  console.error('Auto-publish needs local Tailscale operator permission on Linux.');
  console.error('Run once:');
  console.error(`  ${tailscaleOperatorCommandForDisplay()}`);
  console.error('');
  console.error('Then rerun:');
  console.error('  web-finder start --auto-publish');
}

function ensureLinuxAutoPublishPermission() {
  if (process.platform !== 'linux') return true;

  const user = os.userInfo().username;
  if (!user || user === 'root') return true;

  const currentOperator = currentTailscaleOperator();
  if (currentOperator === null) return true;
  if (currentOperator === user) return true;
  if (currentOperator) {
    console.error(`Tailscale operator is already set to ${currentOperator}. WebFinder will not change it.`);
    console.error('Ask that user or an admin to run WebFinder, or update the Tailscale operator manually.');
    return false;
  }

  if (!process.stdin.isTTY || !process.stdout.isTTY) {
    printAutoPublishPermissionInstructions();
    return false;
  }

  const cmd = tailscaleCommand();
  if (!cmd) {
    console.error('Auto-publish needs Tailscale, but the tailscale command was not found.');
    return false;
  }

  console.log('');
  console.log('Auto-publish needs local Tailscale operator permission on Linux so WebFinder can manage Tailscale Serve mappings for detected web UIs.');
  console.log('');
  console.log('Run this now?');
  console.log(`  ${tailscaleOperatorCommandForDisplay()}`);
  console.log('');

  if (!promptYesNo('Continue?')) {
    console.error('Auto-publish was not started. Run `web-finder start` for passive mode, or rerun `web-finder start --auto-publish` and approve the Tailscale operator setup.');
    return false;
  }

  try {
    execSync(`sudo ${quoteShell(cmd)} set --operator=${quoteShell(user)}`, { stdio: 'inherit' });
  } catch (e) {
    console.error('Failed to set Tailscale operator permission:', e.message);
    return false;
  }

  const nextOperator = currentTailscaleOperator();
  if (nextOperator && nextOperator !== user) {
    console.error(`Tailscale operator is now set to ${nextOperator}, not ${user}. Auto-publish was not started.`);
    return false;
  }

  return true;
}

function isTailscaleServePermissionError(error) {
  const msg = error?.message || '';
  return msg.includes('serve config denied') || msg.includes('tailscale set --operator');
}

function printTailscaleServePermissionHelp({ autoPublish = false } = {}) {
  console.error('Tailscale Serve setup skipped: local Tailscale operator permission is required.');
  console.error('Run once:');
  console.error(`  ${tailscaleOperatorCommandForDisplay()}`);
  console.error('');
  console.error('Then rerun:');
  console.error(`  web-finder start${autoPublish ? ' --auto-publish' : ''}`);
}

function readAutoPublishedPorts() {
  try {
    return fs.readFileSync(AUTO_PUBLISH_STATE, 'utf8')
      .split('\n')
      .map(line => parseInt(line.trim()))
      .filter(port => Number.isInteger(port) && port > 0);
  } catch {
    return [];
  }
}

function writeAutoPublishedPorts(ports) {
  const unique = Array.from(new Set(ports)).sort((a, b) => a - b);
  if (unique.length === 0) {
    try { fs.unlinkSync(AUTO_PUBLISH_STATE); } catch {}
    return;
  }
  fs.writeFileSync(AUTO_PUBLISH_STATE, `${unique.join('\n')}\n`);
}

function hasCommand(cmd) {
  try {
    execSync(`command -v ${cmd}`, { encoding: 'utf8' });
    return true;
  } catch {
    return false;
  }
}

function sameRealPath(a, b) {
  try {
    return fs.realpathSync(a) === fs.realpathSync(b);
  } catch {
    return false;
  }
}

function preferredBinPath() {
  const candidates = [
    process.argv[1],
    '/opt/homebrew/bin/web-finder',
    '/usr/local/bin/web-finder',
    realBin,
  ];
  return candidates.find(candidate => candidate && fs.existsSync(candidate) && sameRealPath(candidate, realBin)) || realBin;
}

function autostartNodeCommand() {
  if (process.platform === 'darwin') {
    return ['/usr/bin/env', 'node'];
  }
  return [process.execPath];
}

function isGitCheckout() {
  try {
    execSync('git rev-parse --is-inside-work-tree', { cwd: repoRoot, stdio: 'ignore' });
    return true;
  } catch {
    return false;
  }
}

function brewInstalled(kind, name) {
  try {
    execSync(`brew list --${kind} ${name}`, { stdio: 'ignore' });
    return true;
  } catch {
    return false;
  }
}

function updateWithHomebrew() {
  if (process.platform !== 'darwin' || !hasCommand('brew')) return false;

  const formulaInstalled = brewInstalled('formula', 'zeulewan/tap/web-finder') ||
                           brewInstalled('formula', 'web-finder');
  const caskInstalled = brewInstalled('cask', 'zeulewan/tap/webfinder') ||
                        brewInstalled('cask', 'webfinder');
  if (!formulaInstalled && !caskInstalled) return false;

  console.log('Updating WebFinder with Homebrew...');
  execSync('brew update', { stdio: 'inherit' });
  if (formulaInstalled) execSync('brew upgrade zeulewan/tap/web-finder', { stdio: 'inherit' });
  if (caskInstalled) execSync('brew upgrade --cask zeulewan/tap/webfinder', { stdio: 'inherit' });
  return true;
}

function isSynology() {
  return fs.existsSync('/etc/synoinfo.conf') || fs.existsSync('/usr/syno');
}

function versionString() {
  let commit = '';
  try {
    if (fs.existsSync(path.join(repoRoot, '.git'))) {
      commit = execSync('git rev-parse --short HEAD', { cwd: repoRoot, encoding: 'utf8' }).trim();
    }
  } catch {}
  return commit ? `${pkg.version} (${commit})` : pkg.version;
}

function serviceStatus() {
  const info = getAutostartInfo();
  if (info.type === 'launchd') {
    try {
      const out = execSync(`launchctl print gui/${process.getuid()}/com.zeul.web-finder-serve`, { encoding: 'utf8' });
      const pid = out.match(/\bpid = (\d+)/)?.[1] || null;
      const running = /\bstate = running\b/.test(out) || Boolean(pid);
      return { installed: true, active: running, pid };
    } catch {
      return { installed: false, active: false, pid: null };
    }
  }

  if (info.type === 'cron') {
    const pid = fs.existsSync(info.pidfile) ? fs.readFileSync(info.pidfile, 'utf8').trim() : null;
    if (pid) {
      try {
        execSync(`kill -0 ${pid}`, { encoding: 'utf8' });
        return { installed: true, active: true, pid };
      } catch {}
    }
    return { installed: fs.existsSync(info.pidfile), active: false, pid: null };
  }

  try {
    const active = execSync('systemctl --user is-active web-finder-serve', { encoding: 'utf8' }).trim();
    let pid = null;
    try {
      const rawPid = execSync('systemctl --user show -p MainPID --value web-finder-serve', { encoding: 'utf8' }).trim();
      pid = rawPid && rawPid !== '0' ? rawPid : null;
    } catch {}
    return { installed: true, active: active === 'active', pid };
  } catch {
    return { installed: false, active: false, pid: null };
  }
}

function tailscaleServeStatus() {
  try {
    const out = execTailscale('serve status');
    return {
      available: true,
      active: out.includes(`:${MANIFEST_PORT}`) || out.includes(`127.0.0.1:${MANIFEST_PORT}`),
      raw: out.trim(),
    };
  } catch (e) {
    return { available: false, active: false, error: e.message };
  }
}

function fetchLocalManifest() {
  return new Promise((resolve) => {
    const req = http.get({
      hostname: '127.0.0.1',
      port: MANIFEST_PORT,
      path: MANIFEST_PATH,
      timeout: 8000,
    }, (res) => {
      let body = '';
      res.setEncoding('utf8');
      res.on('data', chunk => { body += chunk; });
      res.on('end', () => {
        if (res.statusCode !== 200) {
          resolve({ ok: false, error: `HTTP ${res.statusCode}` });
          return;
        }
        try {
          resolve({ ok: true, manifest: JSON.parse(body) });
        } catch (e) {
          resolve({ ok: false, error: e.message });
        }
      });
    });
    req.on('timeout', () => req.destroy(new Error('timeout')));
    req.on('error', e => resolve({ ok: false, error: e.message }));
  });
}

async function magicDnsStatus() {
  try {
    const status = JSON.parse(execTailscale('status --json'));
    const dnsName = status.Self?.DNSName;
    if (!dnsName) return { available: true, ok: false, warning: 'Tailscale DNSName unavailable.' };
    try {
      await dns.lookup(dnsName);
      return { available: true, ok: true, dnsName };
    } catch {
      return {
        available: true,
        ok: false,
        dnsName,
        warning: 'Tailscale MagicDNS is not resolving on this machine; run `tailscale set --accept-dns=true` for clickable .ts.net links.',
      };
    }
  } catch (e) {
    return { available: false, ok: false, warning: `Tailscale status unavailable: ${e.message}` };
  }
}

async function printStatus({ debug = false } = {}) {
  const svc = serviceStatus();
  const serve = tailscaleServeStatus();
  const manifest = await fetchLocalManifest();
  const magicDns = await magicDnsStatus();

  console.log(`web-finder ${versionString()}`);
  console.log(`Daemon: ${svc.active ? `running${svc.pid ? ` (pid ${svc.pid})` : ''}` : svc.installed ? 'installed but not running' : 'not installed'}`);
  console.log(`Manifest: ${manifest.ok ? `available at http://127.0.0.1:${MANIFEST_PORT}${MANIFEST_PATH}` : `unavailable (${manifest.error})`}`);
  console.log(`Tailscale Serve: ${serve.active ? 'enabled' : serve.available ? 'not enabled' : 'unavailable'}`);
  console.log(`MagicDNS: ${magicDns.ok ? `working (${magicDns.dnsName})` : 'not resolving'}`);
  if (magicDns.warning) console.log(`Warning: ${magicDns.warning}`);

  if (manifest.ok) {
    const services = manifest.manifest.services || [];
    console.log(`Advertised services: ${services.length}`);
    for (const service of services) {
      console.log(`  - ${service.name || `:${service.port}`} ${service.url}`);
    }
  }

  if (debug && serve.raw) {
    console.log('\nTailscale Serve status:');
    console.log(serve.raw);
  }
}

// MARK: - Autostart helpers

function getAutostartInfo() {
  const nodeCommand = autostartNodeCommand();
  const binPath  = preferredBinPath();
  if (process.platform === 'darwin') {
    return {
      type: 'launchd',
      plist: path.join(os.homedir(), 'Library', 'LaunchAgents', 'com.zeul.web-finder-serve.plist'),
      nodeCommand, binPath,
    };
  }
  if (isSynology() || !hasCommand('systemctl')) {
    return {
      type: 'cron',
      pidfile: path.join(os.homedir(), '.web-finder-serve.pid'),
      nodeCommand, binPath,
    };
  }
  return {
    type: 'systemd',
    unit: path.join(os.homedir(), '.config', 'systemd', 'user', 'web-finder-serve.service'),
    nodeCommand, binPath,
  };
}

function setupTailscaleServe({ autoPublish = false } = {}) {
  try {
    try { execTailscale(`serve --http=${MANIFEST_PORT} off`); } catch {}
    execTailscale(`serve --bg --https=${MANIFEST_PORT} http://127.0.0.1:${MANIFEST_PORT}`);
    console.log('Tailscale Serve enabled for tailnet-only manifest access.');
  } catch (e) {
    if (isTailscaleServePermissionError(e)) {
      printTailscaleServePermissionHelp({ autoPublish });
      return;
    }
    console.error('Tailscale Serve setup skipped:', e.message);
  }
}

async function syncTailscaleServeServices({ showAll = false } = {}) {
  const existingServeMap = await getTailscaleServeMap();
  const services = await scanLocalSS({ showAll });
  let count = 0;
  const autoPublishedPorts = readAutoPublishedPorts();
  for (const service of services) {
    if (!service.port || service.port === MANIFEST_PORT) continue;
    if (existingServeMap.has(service.port)) continue;
    let target;
    try {
      const url = new URL(service.url);
      const scheme = url.protocol === 'https:' ? 'https+insecure' : 'http';
      target = `${scheme}://127.0.0.1:${service.port}`;
    } catch {
      target = `http://127.0.0.1:${service.port}`;
    }
    try {
      execTailscale(`serve --bg --https=${service.port} ${quoteShell(target)}`);
      autoPublishedPorts.push(service.port);
      count += 1;
    } catch (e) {
      console.error(`Tailscale Serve setup skipped for ${service.title || `:${service.port}`}: ${e.message}`);
    }
  }
  writeAutoPublishedPorts(autoPublishedPorts);
  if (count > 0) console.log(`Tailscale Serve enabled for ${count} local service(s).`);
  return count;
}

function removeTailscaleServe({ removeAutoPublished = false } = {}) {
  if (removeAutoPublished) {
    for (const port of readAutoPublishedPorts()) {
      try { execTailscale(`serve --https=${port} off`); } catch {}
      try { execTailscale(`serve --http=${port} off`); } catch {}
    }
    writeAutoPublishedPorts([]);
  }
  try {
    execTailscale(`serve --https=${MANIFEST_PORT} off`);
  } catch {}
  try {
    execTailscale(`serve --http=${MANIFEST_PORT} off`);
    console.log('Tailscale Serve disabled.');
  } catch {}
}

function setupAutostart({ autoPublish = false } = {}) {
  const info = getAutostartInfo();
  const serveArgs = autoPublish
    ? ['serve', '--host', '127.0.0.1', '--auto-publish']
    : ['serve', '--host', '127.0.0.1'];
  try {
    if (info.type === 'launchd') {
      const xml = `<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key><string>com.zeul.web-finder-serve</string>
    <key>EnvironmentVariables</key>
    <dict>
        <key>PATH</key><string>${LAUNCHD_PATH}</string>
    </dict>
    <key>ProgramArguments</key>
    <array>
        ${info.nodeCommand.map(arg => `<string>${arg}</string>`).join('\n        ')}
        <string>${info.binPath}</string>
        ${serveArgs.map(arg => `<string>${arg}</string>`).join('\n        ')}
    </array>
    <key>RunAtLoad</key><true/>
    <key>KeepAlive</key><true/>
    <key>StandardOutPath</key><string>/tmp/web-finder-serve.log</string>
    <key>StandardErrorPath</key><string>/tmp/web-finder-serve.log</string>
</dict>
</plist>`;
      fs.mkdirSync(path.dirname(info.plist), { recursive: true });
      fs.writeFileSync(info.plist, xml);
      try { execSync(`launchctl unload "${info.plist}" 2>/dev/null`, { encoding: 'utf8' }); } catch {}
      execSync(`launchctl load "${info.plist}"`, { encoding: 'utf8' });
      console.log('Autostart enabled (LaunchAgent).');
    } else if (info.type === 'cron') {
      const marker = '# web-finder-serve';
      if (hasCommand('crontab')) {
        const cronLine = `@reboot ${info.nodeCommand.map(quoteShell).join(' ')} ${quoteShell(info.binPath)} ${serveArgs.map(quoteShell).join(' ')} >> /tmp/web-finder-serve.log 2>&1 ${marker}`;
        let existing = '';
        try { existing = execSync('crontab -l 2>/dev/null', { encoding: 'utf8' }); } catch {}
        const next = existing
          .split('\n')
          .filter(line => line.trim() && !line.includes(marker))
          .concat(cronLine)
          .join('\n') + '\n';
        const tmp = path.join(os.tmpdir(), `web-finder-cron-${process.pid}`);
        fs.writeFileSync(tmp, next);
        execSync(`crontab ${quoteShell(tmp)}`, { encoding: 'utf8' });
        fs.unlinkSync(tmp);
        console.log('Autostart enabled (cron).');
      } else {
        console.log('Autostart unavailable: crontab not found; starting for current boot only.');
      }
      if (fs.existsSync(info.pidfile)) {
        const pid = fs.readFileSync(info.pidfile, 'utf8').trim();
        if (pid) {
          try { execSync(`kill ${pid}`, { encoding: 'utf8' }); } catch {}
        }
      }
      const startCmd = `nohup ${info.nodeCommand.map(quoteShell).join(' ')} ${quoteShell(info.binPath)} ${serveArgs.map(quoteShell).join(' ')} >> /tmp/web-finder-serve.log 2>&1 & echo $! > ${quoteShell(info.pidfile)}`;
      execSync(startCmd, { encoding: 'utf8' });
      console.log('Manifest server started.');
    } else {
      const unit = `[Unit]
Description=web-finder manifest server

[Service]
ExecStart=${info.nodeCommand.join(' ')} ${info.binPath} ${serveArgs.join(' ')}
Restart=on-failure
RestartSec=5

[Install]
WantedBy=default.target
`;
      fs.mkdirSync(path.dirname(info.unit), { recursive: true });
      fs.writeFileSync(info.unit, unit);
      execSync('systemctl --user daemon-reload', { encoding: 'utf8' });
      execSync('systemctl --user enable --now web-finder-serve', { encoding: 'utf8' });
      execSync('systemctl --user restart web-finder-serve', { encoding: 'utf8' });
      console.log('Autostart enabled (systemd).');
    }
    setupTailscaleServe({ autoPublish });
  } catch (e) {
    console.error('Autostart setup failed:', e.message);
  }
}

function removeAutostart() {
  const info = getAutostartInfo();
  try {
    if (info.type === 'launchd') {
      if (fs.existsSync(info.plist)) {
        try { execSync(`launchctl unload "${info.plist}"`, { encoding: 'utf8' }); } catch {}
        fs.unlinkSync(info.plist);
        console.log('Autostart disabled.');
      } else {
        console.log('Autostart was not enabled.');
      }
    } else if (info.type === 'cron') {
      const marker = '# web-finder-serve';
      if (hasCommand('crontab')) {
        let existing = '';
        try { existing = execSync('crontab -l 2>/dev/null', { encoding: 'utf8' }); } catch {}
        const next = existing
          .split('\n')
          .filter(line => line.trim() && !line.includes(marker))
          .join('\n');
        const tmp = path.join(os.tmpdir(), `web-finder-cron-${process.pid}`);
        fs.writeFileSync(tmp, next ? `${next}\n` : '');
        execSync(`crontab ${quoteShell(tmp)}`, { encoding: 'utf8' });
        fs.unlinkSync(tmp);
      }
      if (fs.existsSync(info.pidfile)) {
        const pid = fs.readFileSync(info.pidfile, 'utf8').trim();
        if (pid) {
          try { execSync(`kill ${pid}`, { encoding: 'utf8' }); } catch {}
        }
        fs.unlinkSync(info.pidfile);
      }
      console.log('Autostart disabled.');
    } else {
      try { execSync('systemctl --user disable --now web-finder-serve', { encoding: 'utf8' }); } catch {}
      if (fs.existsSync(info.unit)) fs.unlinkSync(info.unit);
      try { execSync('systemctl --user daemon-reload', { encoding: 'utf8' }); } catch {}
      console.log('Autostart disabled.');
    }
    removeTailscaleServe({ removeAutoPublished: true });
  } catch (e) {
    console.error('Failed to disable autostart:', e.message);
  }
}

const args = process.argv.slice(2);
const command = args.find(a => !a.startsWith('-')) || '';
const autoPublishMode = args.includes('--auto-publish');

if (command === 'version' || args.includes('--version') || args.includes('-v')) {
  console.log(versionString());
  process.exit(0);
}

if (command === 'update' || args.includes('--update') || args.includes('-u')) {
  if (isGitCheckout()) {
    console.log('Updating web-finder CLI...');
    try {
      const out = execSync('git pull --ff-only', { cwd: repoRoot, encoding: 'utf8' });
      process.stdout.write(out);
    } catch (e) {
      console.error('Update failed:', e.message);
      process.exit(1);
    }

    // On macOS, also update the desktop app if installed. Prefer the checked-out
    // repo so CLI/app fixes stay in lockstep without waiting for a release zip.
    if (process.platform === 'darwin') {
      const userApps  = path.join(os.homedir(), 'Applications', 'WebFinder.app');
      const sysApps   = '/Applications/WebFinder.app';
      const appPath   = fs.existsSync(sysApps) ? sysApps : fs.existsSync(userApps) ? userApps : null;
      const installDirs = [
        fs.existsSync(sysApps) ? '/Applications' : null,
        fs.existsSync(userApps) ? path.join(os.homedir(), 'Applications') : null,
      ].filter(Boolean);
      if (installDirs.length === 0) installDirs.push(path.join(os.homedir(), 'Applications'));

      try {
        const macosDir = path.join(repoRoot, '..', 'macos');
        const buildScript = path.join(macosDir, 'build.sh');
        const builtApp = path.join(macosDir, 'WebFinder.app');
        if (fs.existsSync(buildScript)) {
          console.log('Building WebFinder.app from checked-out repo...');
          execSync('./build.sh', { cwd: macosDir, stdio: 'inherit' });
          for (const installDir of installDirs) {
            fs.mkdirSync(installDir, { recursive: true });
            execSync(`rm -rf "${path.join(installDir, 'WebFinder.app')}" && cp -R "${builtApp}" "${installDir}/"`, { stdio: 'inherit' });
            console.log(`WebFinder.app installed in ${installDir}.`);
          }
          console.log('Restart the app to use the updated build.');
        } else {
          const installed = appPath
            ? execSync(`defaults read "${appPath}/Contents/Info.plist" CFBundleShortVersionString`, { encoding: 'utf8' }).trim()
            : '0';
          const redirect = execSync('curl -sI -o /dev/null -w "%{url_effective}" -L https://github.com/zeulewan/web-finder/releases/latest', { encoding: 'utf8' }).trim();
          const latest = redirect.match(/\/tag\/v?(.+)$/)?.[1] || '';
          if (installed === latest) {
            console.log(`WebFinder.app already up to date (${installed}).`);
          } else {
            const appUrl = 'https://github.com/zeulewan/web-finder/releases/latest/download/WebFinder.app.zip';
            const tmpZip = path.join(repoRoot, 'WebFinder.app.zip');
            const destDir = fs.existsSync(sysApps) ? '/Applications' : path.join(os.homedir(), 'Applications');
            console.log(`Updating WebFinder.app ${installed} -> ${latest}...`);
            execSync(`curl -fsSL -o "${tmpZip}" "${appUrl}"`, { encoding: 'utf8' });
            fs.mkdirSync(destDir, { recursive: true });
            execSync(`rm -rf "${path.join(destDir, 'WebFinder.app')}" && unzip -q "${tmpZip}" -d "${destDir}"`, { stdio: 'inherit' });
            fs.unlinkSync(tmpZip);
            console.log(`WebFinder.app updated in ${destDir}.`);
          }
        }
      } catch (e) {
        console.error('App update failed:', e.message);
      }
    }
  } else if (!updateWithHomebrew()) {
    console.error('Update failed: this install is not a git checkout. Use your package manager or reinstall WebFinder.');
    process.exit(1);
  }

  if (autoPublishMode && !ensureLinuxAutoPublishPermission()) process.exit(1);

  // Set up autostart as part of every update
  setupAutostart({ autoPublish: autoPublishMode });

  process.exit(0);
}

if (command === 'start') {
  if (autoPublishMode && !ensureLinuxAutoPublishPermission()) process.exit(1);
  setupAutostart({ autoPublish: autoPublishMode });
  process.exit(0);
}

if (command === 'stop') {
  removeAutostart();
  process.exit(0);
}

if (command === 'status' || command === 'diagnose') {
  printStatus({ debug: command === 'diagnose' || args.includes('--debug') })
    .then(() => process.exit(0))
    .catch((e) => {
      console.error('Status failed:', e.message);
      process.exit(1);
    });
  return;
}

if (args[0] === 'autostart') {
  const sub = args[1];
  if (sub === 'on' || sub === 'enable') {
    if (autoPublishMode && !ensureLinuxAutoPublishPermission()) process.exit(1);
    setupAutostart({ autoPublish: autoPublishMode });
  } else if (sub === 'off' || sub === 'disable') {
    removeAutostart();
  } else {
    console.log('Usage: web-finder autostart on|off');
  }
  process.exit(0);
}

if (args[0] === 'serve') {
  const portIdx  = args.indexOf('--port');
  const hostIdx  = args.indexOf('--host');
  const noTsServe = args.includes('--no-tailscale-serve');
  const autoPublish = args.includes('--auto-publish');
  const servePort = portIdx !== -1 ? parseInt(args[portIdx + 1]) : MANIFEST_PORT;
  const serveHost = hostIdx !== -1 ? args[hostIdx + 1] : (process.env.WEB_FINDER_HOST || '127.0.0.1');
  const showAll  = args.includes('--debug') || args.includes('--all') || args.includes('-a');
  const cacheMs = 15000;
  const staleKeepMs = 5 * 60 * 1000;
  let manifestCache = null;
  let manifestCacheAt = 0;
  let manifestRefresh = null;

  async function buildManifest() {
    if (autoPublish && serveHost === '127.0.0.1' && !noTsServe) {
      await syncTailscaleServeServices({ showAll });
    }
    const services = await scanLocalSS({ showAll, tailnetOnly: true });
    return {
      version:  1,
      hostname: os.hostname(),
      services: services
        .filter(s => s.port !== MANIFEST_PORT)
        .map(s => ({ name: s.title, port: s.port, url: s.url })),
    };
  }

  async function refreshManifestCache() {
    if (manifestRefresh) return manifestRefresh;
    manifestRefresh = buildManifest()
      .then((manifest) => {
        const now = Date.now();
        const oldCount = manifestCache?.services?.length || 0;
        const newCount = manifest.services.length;
        if (manifestCache && newCount < oldCount && now - manifestCacheAt < staleKeepMs) {
          manifestCacheAt = now;
          return manifestCache;
        }
        manifestCache = manifest;
        manifestCacheAt = now;
        return manifestCache;
      })
      .finally(() => { manifestRefresh = null; });
    return manifestRefresh;
  }

  const server = http.createServer(async (req, res) => {
    if (req.url !== MANIFEST_PATH) {
      res.writeHead(404, { 'Content-Type': 'text/plain' });
      res.end('Not found\n');
      return;
    }
    try {
      const manifest = (manifestCache && Date.now() - manifestCacheAt < cacheMs)
        ? manifestCache
        : await refreshManifestCache();
      res.writeHead(200, {
        'Content-Type':                'application/json',
        'Access-Control-Allow-Origin': '*',
        'Cache-Control':               'no-store',
      });
      res.end(JSON.stringify(manifest));
    } catch (e) {
      res.writeHead(500, { 'Content-Type': 'application/json' });
      res.end(JSON.stringify({ error: e.message }));
    }
  });

  server.listen(servePort, serveHost, () => {
    console.log(`web-finder manifest server listening on ${serveHost}:${servePort}`);
    console.log(`Endpoint: http://localhost:${servePort}${MANIFEST_PATH}`);
    (async () => {
      if (serveHost === '127.0.0.1' && servePort === MANIFEST_PORT && !noTsServe) {
        setupTailscaleServe({ autoPublish });
      }
      await refreshManifestCache();
    })().catch(e => console.error('Initial manifest refresh failed:', e.message));
    console.log('Press Ctrl+C to stop.');
  });

  process.on('SIGTERM', () => server.close(() => process.exit(0)));
  // Keep running
  return;
}

if (args.includes('--help') || args.includes('-h')) {
  console.log(`
Usage: web-finder [command] [options]

Commands:
  web-finder              Find local services and Tailscale-published peer services
  web-finder start --auto-publish
                          Recommended: publish detected local web UIs with Tailscale Serve
  web-finder start        Passive default: advertise existing Tailscale Serve mappings
  web-finder stop         Stop sharing this machine and disable autostart
  web-finder status       Check daemon, Tailscale Serve, MagicDNS, and version
  web-finder update       Update WebFinder and restart sharing
  web-finder version      Show version

Options:
  --json, -j          Output as JSON for apps/scripts
  --debug             Show noisy diagnostics, all open ports, and no-service peers
  --auto-publish      With start/serve, publish detected local web UIs via Tailscale Serve
  --version, -v       Show version
  --help, -h          Show this help

By default, web-finder only shows machines that are actually serving something.
Recommended setup is web-finder start --auto-publish. It is not the default:
plain web-finder start only advertises services already exposed with Tailscale Serve.
On Linux, auto-publish may prompt to set local Tailscale operator permission.
Use --debug when you need the full/noisy view.

Examples:
  web-finder
  web-finder start --auto-publish
  web-finder start
  web-finder status
  web-finder --debug
  web-finder --json
`);
  process.exit(0);
}

const wantLocal     = args.includes('--local')     || args.includes('-l');
const wantTailscale = args.includes('--tailscale') || args.includes('-t');
const debugMode     = args.includes('--debug')     || args.includes('--all') || args.includes('-a');
const showAll       = debugMode;
const jsonMode      = args.includes('--json')      || args.includes('-j');

if (command && !['serve', 'autostart'].includes(command)) {
  console.error(`Unknown command: ${command}`);
  console.error('Run `web-finder --help` for usage.');
  process.exit(1);
}

const doLocal     = wantLocal     || (!wantLocal && !wantTailscale);
const doTailscale = wantTailscale || (!wantLocal && !wantTailscale);

const isTTY = process.stdout.isTTY;
const dim   = isTTY ? '\x1b[2m' : '';
const reset = isTTY ? '\x1b[0m' : '';

function pad(str, len) {
  return str.length >= len ? str : str + ' '.repeat(len - str.length);
}

async function main() {
  const result = {};
  const tasks  = [];

  if (doLocal)     tasks.push(scanLocalSS({ showAll }).then(r   => { result.local     = r; }));
  if (doLocal)     tasks.push(scanGateway({ showAll }).then(r  => { result.gateway   = r; }));
  if (doTailscale) tasks.push(scanTailscale({ showAll }).then(r => { result.tailscale = r; }));
  await Promise.all(tasks);

  if (jsonMode) {
    console.log(JSON.stringify(result, null, 2));
    return;
  }

  if (result.local !== undefined) {
    console.log('\nLocal:');
    if (result.local.length === 0) {
      console.log('  (none found)');
    } else {
      for (const s of result.local) {
        console.log(`  \u25CF  ${pad(s.title, 28)} ${s.url}`);
      }
    }
  }

  if (result.gateway) {
    console.log(`\n${result.gateway.name}:`);
    for (const s of result.gateway.services) {
      console.log(`  \u25CF  ${pad(s.title, 28)} ${s.url}`);
    }
  }

  if (result.tailscale !== undefined) {
    console.log('\nTailscale:');
    if (result.tailscale.error) {
      console.log(`  Error: ${result.tailscale.error}`);
    } else if (!result.tailscale.peers || result.tailscale.peers.length === 0) {
      console.log('  (no peers)');
    } else {
      for (const warning of result.tailscale.warnings || []) {
        console.log(`  !  ${warning}`);
      }
      // Sort: has services first, then offline
      const sorted = [...result.tailscale.peers].sort((a, b) => {
        if (!a.online && b.online)  return 1;
        if (a.online  && !b.online) return -1;
        const as = (a.services || []).length;
        const bs = (b.services || []).length;
        if (as === 0 && bs > 0) return 1;
        if (as > 0 && bs === 0) return -1;
        return a.name.localeCompare(b.name);
      });
      const visible = debugMode ? sorted : sorted.filter(peer => peer.online && (peer.services || []).length > 0);

      if (visible.length === 0) {
        console.log('  (no services found)');
      }

      for (const peer of visible) {
        if (!peer.online) {
          console.log(`  \u25CB  ${peer.name}`);
        } else if (!peer.services || peer.services.length === 0) {
          console.log(`  \u25CE  ${peer.name}  ${dim}(no services)${reset}`);
        } else {
          for (const warning of peer.warnings || []) {
            console.log(`  !  ${peer.name}: ${warning}`);
          }
          for (const svc of peer.services) {
            console.log(`  \u25CF  ${pad(peer.name, 16)} ${pad(svc.title, 28)} ${svc.url}`);
          }
        }
      }
    }
  }

  console.log('');
}

main().catch(err => {
  console.error('Error:', err.message);
  process.exit(1);
});
